#!/usr/bin/env bash

set -euo pipefail

# name;label;panes
LAYOUTS=(
  "even-horizontal;even horizontal;3"
  "claude-vim;claude + vim + terminal;3"
)

pane_count_for() {
  local entry
  for entry in "${LAYOUTS[@]}"; do
    if [ "${entry%%;*}" = "$1" ]; then
      printf '%s' "${entry##*;}"
      return 0
    fi
  done
  return 1
}

preview_layout() {
  case "$1" in
    even-horizontal)
      cat <<'ART'
┌───────┬───────┬───────┐
│ pane0 │ pane1 │ pane2 │
└───────┴───────┴───────┘
ART
      ;;
    claude-vim)
      cat <<'ART'
┌───────────────┬───────────────┐
│               │               │
│    claude     │      vim      │
│     50%       │               │
│               │               │
│               ├───────────────┤
│               │   terminal    │
│               │     20%       │
└───────────────┴───────────────┘
ART
      ;;
  esac
}

panes_in_window() {
  tmux list-panes | wc -l | tr -d ' '
}

# split until the window holds at least $1 panes
grow_panes() {
  local target="$1" count dir
  count=$(panes_in_window)
  dir=$(tmux display-message -p '#{pane_current_path}')
  while [ "$count" -lt "$target" ]; do
    tmux split-window -h -c "$dir"
    count=$((count + 1))
  done
}

# kill panes past the $1:th
trim_panes() {
  local target="$1" count
  count=$(panes_in_window)
  while [ "$count" -gt "$target" ]; do
    tmux kill-pane -t ":.{last}"
    count=$((count - 1))
  done
}

apply_claude_vim() {
  local target
  target=$(pane_count_for claude-vim)
  trim_panes "$target"
  grow_panes "$target"

  # normalize: main-vertical puts pane 0 left, panes 1/2 stacked on right
  tmux select-layout main-vertical

  # resize: pane 0 = 50% width, pane 2 = 20% height
  tmux resize-pane -t 0 -x 50%
  tmux resize-pane -t 2 -y 20%
  tmux select-pane -t 0
}

if [ "${1:-}" = "--preview" ]; then
  preview_layout "$2"
  exit 0
elif [ -n "${1:-}" ]; then
  name="$1"
else
  name=$(
    printf '%s\n' "${LAYOUTS[@]}" |
      fzf --reverse --no-info --prompt='layout> ' --delimiter=';' --with-nth=2 \
        --preview="$0 --preview {1}" --preview-window=right:35 |
      cut -d';' -f1
  )
fi

case "$name" in
  even-horizontal)
    grow_panes "$(pane_count_for even-horizontal)"
    tmux select-layout even-horizontal
    ;;
  claude-vim) apply_claude_vim ;;
  *) echo "Unknown layout: $name"; exit 1 ;;
esac
