#!/usr/bin/env bash

set -euo pipefail

# herdr-session-launcher — pick a herdr workspace, or open a project
# directory as one.
#
# Bound to prefix+space as a herdr popup; that picker is the only entry point.
# `--list` exists solely so fzf's ctrl-x binding can reload the list.
#
# Herdr's own prefix+w picker only lists live workspaces. This adds the other
# half: project directories that don't have a workspace yet, opened with one tab
# per git worktree — the clone as "main", then every `<repo>--<name>` sibling.
# Opening is safe to re-run: worktrees that already own a tab are left alone.
#
# Each tab gets shell left (40%), nvim top right, two shells below it.
#
# Note: herdr's API carries no last-attached timestamp, so recency is sampled
# here — each time the picker opens, the workspace being left is stamped. A
# switch made some other way (prefix+shift+N, the sidebar) is picked up the next
# time the picker opens, which keeps the order honest without a daemon.

usage() {
  echo 'usage: herdr-session-launcher [--list]' >&2
  exit 1
}

mru_file="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-session-launcher/mru"

# Move the focused workspace to the front of the MRU list. Called once per
# picker invocation, before the list is built.
stamp_focused() {
  local workspaces ws now tmp
  workspaces=$(herdr workspace list | jq -r '.result.workspaces[] |
    "\(if .focused then "*" else "-" end)\t\(.workspace_id)"')
  ws=$(awk -F'\t' '$1 == "*" { print $2 }' <<<"$workspaces")
  [ -n "$ws" ] || return 0
  now=$(date +%s)
  mkdir -p "${mru_file%/*}"
  tmp=$(mktemp)
  printf '%s\t%s\n' "$ws" "$now" >"$tmp"
  if [ -f "$mru_file" ]; then
    # keep the rest in order, minus this workspace and any that have since been
    # closed — herdr reuses workspace ids, so a stale entry would rank a fresh
    # workspace as if it were the old one
    awk -F'\t' -v w="$ws" '
      NR == FNR { live[$2] = 1; next }
      $1 != w && live[$1]' - "$mru_file" <<<"$workspaces" >>"$tmp"
  fi
  mv "$tmp" "$mru_file"
}

project_dirs() {
  find "$HOME/code" -maxdepth 1 -mindepth 1 -type d ! -name '*--*' 2>/dev/null
  echo "$HOME/.dotfiles"
  echo "$HOME/notes"
}

# One pane list answers every "is this directory already open?" question. Keyed
# on pane cwd rather than workspace label: a renamed workspace still covers its
# project, where a label match would miss it and open a second workspace for the
# same checkout.
pane_index() {
  herdr pane list | jq -r '.result.panes[] | "\(.workspace_id)\t\(.cwd)"'
}

# First workspace holding a pane at or below $1, or nothing
workspace_for_path() {
  local root=$1 index=$2 ws cwd
  while IFS=$'\t' read -r ws cwd; do
    if [ "$cwd" = "$root" ] || [ "${cwd#"$root"/}" != "$cwd" ]; then
      printf '%s\n' "$ws"
      return 0
    fi
  done <<<"$index"
}

# Ratios apply to the pane being split, so 0.4 leaves the right column 60% wide
layout_tab() {
  local pane=$1 cwd=$2 right bottom
  right=$(herdr pane split "$pane" --direction right --ratio 0.4 --cwd "$cwd" --no-focus |
    jq -r '.result.pane.pane_id')
  bottom=$(herdr pane split "$right" --direction down --ratio 0.75 --cwd "$cwd" --no-focus |
    jq -r '.result.pane.pane_id')
  herdr pane split "$bottom" --direction right --ratio 0.5 --cwd "$cwd" --no-focus >/dev/null
  herdr pane run "$right" nvim >/dev/null
}

# Resolve the clone root, so passing a worktree path still opens one workspace
# for the whole project. Sets root, worktrees, label, main_label.
resolve_project() {
  local dir=$1 common_dir
  if common_dir=$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null); then
    case $common_dir in
      /*) ;;
      *) common_dir=$dir/$common_dir ;;
    esac
    root=$(cd "$common_dir/.." && pwd -P)
    # first line is always the main worktree
    mapfile -t worktrees < <(git -C "$root" worktree list --porcelain |
      awk '/^worktree /{print substr($0, 10)}')
    # adopt git's spelling of the path, so pane cwds compare equal
    root=${worktrees[0]}
    main_label=main
  else
    root=$dir
    worktrees=("$dir")
    main_label=${root##*/}
  fi
  label=${root##*/}
}

open_project() {
  local dir=$1

  [ -d "$dir" ] || {
    echo "herdr-session-launcher: no such directory: $dir" >&2
    exit 1
  }
  dir=$(cd "$dir" && pwd)

  local root worktrees label main_label
  resolve_project "$dir"

  local index workspace covered=()
  index=$(pane_index)
  workspace=$(workspace_for_path "$root" "$index")

  if [ -z "$workspace" ]; then
    local created
    created=$(herdr workspace create --cwd "$root" --label "$label" --focus)
    workspace=$(jq -r '.result.workspace.workspace_id' <<<"$created")
    herdr tab rename "$(jq -r '.result.tab.tab_id' <<<"$created")" "$main_label" >/dev/null
    layout_tab "$(jq -r '.result.root_pane.pane_id' <<<"$created")" "$root"
    covered=("$root")
  else
    herdr workspace focus "$workspace" >/dev/null
    mapfile -t covered < <(awk -F'\t' -v w="$workspace" '$1 == w { print $2 }' <<<"$index")
  fi

  local worktree name cwd skip tab
  for worktree in "${worktrees[@]}"; do
    skip=0
    for cwd in "${covered[@]}"; do
      if [ "$cwd" = "$worktree" ] || [ "${cwd#"$worktree"/}" != "$cwd" ]; then
        skip=1
        break
      fi
    done
    if [ "$skip" = 1 ]; then
      continue
    fi

    name=${worktree##*/}
    name=${name#"$label"--}
    [ "$worktree" = "$root" ] && name=$main_label

    tab=$(herdr tab create --workspace "$workspace" --cwd "$worktree" --label "$name" --no-focus)
    layout_tab "$(jq -r '.result.root_pane.pane_id' <<<"$tab")" "$worktree"
  done
}

list_entries() {
  local d base index
  local icon_workspace=$'\033[32m\xee\x9a\xb6\033[0m'  # nf-cod-terminal_tmux (green)
  local icon_folder=$'\xef\x81\xbb'                    # nf-fa-folder

  index=$(pane_index)

  local mru=''
  [ -f "$mru_file" ] && mru=$(cat "$mru_file")

  # Most recent first; never-visited workspaces fall back to workspace number.
  # The focused workspace sorts last — you can't switch to where you already
  # are, it's only in the list so ctrl-x can close it.
  herdr workspace list |
    jq -r --arg icon "$icon_workspace" --arg mru "$mru" '
      ($mru | split("\n") | map(select(length > 0) | split("\t"))
        | map({key: .[0], value: (.[1] | tonumber)}) | from_entries) as $seen
      | .result.workspaces
      | sort_by([
          (if .focused then 1 else 0 end),
          (if $seen[.workspace_id] then 0 else 1 end),
          (if $seen[.workspace_id] then -$seen[.workspace_id] else .number end)
        ])
      | .[] | "w\t\(.workspace_id)\t\($icon)  \(.label)"'

  while IFS= read -r d; do
    base=${d##*/}
    # a live workspace already has a pane inside this directory
    [ -n "$(workspace_for_path "$d" "$index")" ] && continue
    printf 'd\t%s\t%s  %s\n' "$d" "$icon_folder" "$base"
  done < <(project_dirs)
}

case ${1:-} in
  --list)
    list_entries
    exit 0
    ;;
  -h | --help) usage ;;
  '') ;;
  *) usage ;;
esac

stamp_focused

selected=$(
  list_entries |
    fzf --ansi --reverse --no-info --prompt='> ' \
        --with-nth=3 --delimiter=$'\t' --tiebreak=index \
        --header='ctrl-x: close workspace' \
        --bind "ctrl-x:execute-silent([ {1} = w ] && herdr workspace close {2})+reload($0 --list)"
)
[ -z "$selected" ] && exit 0

type=${selected%%$'\t'*}
rest=${selected#*$'\t'}
key=${rest%%$'\t'*}

if [ "$type" = "w" ]; then
  herdr workspace focus "$key" >/dev/null
else
  # one tab for the clone, one per worktree
  open_project "$key"
fi
